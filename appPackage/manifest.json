{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
    "manifestVersion": "1.24",
    "version": "3.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "David Rousset",
        "websiteUrl": "https://www.davrous.com",
        "privacyUrl": "https://www.davrous.com",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "outline": "outline.png",
        "color": "JARVIB_192.png"
    },
    "name": {
        "short": "MusicalJARVIB${{APP_NAME_SUFFIX}}",
        "full": "full name for MusicalJARVIB"
    },
    "description": {
        "short": "A smart bot that can create dynamic 3D worlds.",
        "full": "Just A Rather Very Intelligent Bot that can create dynamic 3D worlds."
    },
    "accentColor": "#FFFFFF",
        "copilotAgents": {
        "customEngineAgents": [
            {
                "type": "bot",
                "id": "${{BOT_ID}}"
            }
        ]
    },
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "personal",
                "team",
                "groupChat"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [
                        "personal"
                    ],
                    "commands": [
                        {
                            "title": "How can you help me?",
                            "description": "How can you help me?"
                        },
                        {
                            "title": "Create a 3D world for me",
                            "description": "Create 12 cubes of different colors, using the rainbow palette, and place them in a circle around me. Add a bright light source in the center of the circle to illuminate the cubes."
                        }
                    ]
                }
            ]
        }
    ],
    "configurableTabs": [
        {
            "configurationUrl": "${{TAB_ENDPOINT}}/?view=config&inTeams=1&load=1",
            "canUpdateConfiguration": false,
            "scopes": [
                "team",
                "groupChat"
            ],
            "context": [
                "meetingSidePanel",
                "meetingStage"
            ]
        }
    ],
    "composeExtensions": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "${{BOT_DOMAIN}}",
        "${{TAB_DOMAIN}}"
    ],
    "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MeetingStage.Write.Chat",
          "type": "Delegated"
        },
        {
          "name": "ChannelMeetingStage.Write.Group",
          "type": "Delegated"
        },
        {
          "name": "LiveShareSession.ReadWrite.Chat",
          "type": "Delegated"
        },
        {
          "name": "LiveShareSession.ReadWrite.Group",
          "type": "Delegated"
        }
      ]
    }
  }
}