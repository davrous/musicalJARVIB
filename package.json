{
    "name": "musicaljarvib",
    "version": "2.0.0",
    "msteams": {
        "teamsAppId": null
    },
    "description": "Musical JARVIB - A Teams SDK agent for dynamic 3D worlds",
    "engines": {
        "node": ">=20"
    },
    "author": "David Rousset",
    "license": "MIT",
    "main": "./lib/src/index.js",
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
        "dev:teamsfx:testtool": "env-cmd --silent -f .localConfigs.testTool npm run dev",
        "dev:teamsfx:launch-testtool": "env-cmd --silent -f env/.env.testtool teamsapptester start",
        "dev": "nodemon -w \"./src/**\" -e ts --exec \"node -r ts-node/register -r dotenv/config ./src/index.ts\"",
        "build": "tsc --build",
        "start": "node -r dotenv/config ./lib/src/index.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "watch": "nodemon --exec \"npm run start\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com"
    },
    "dependencies": {
        "@azure-rest/ai-inference": "latest",
        "@azure/core-auth": "latest",
        "@azure/core-sse": "latest",
        "@microsoft/teams.ai": "^2.0.5",
        "@microsoft/teams.api": "^2.0.5",
        "@microsoft/teams.apps": "^2.0.5",
        "@microsoft/teams.cards": "^2.0.5",
        "@microsoft/teams.openai": "^2.0.5",
        "babylonjs": "^9.1.0",
        "babylonjs-loaders": "^9.1.0",
        "dotenv": "^16.4.7",
        "express": "^5.0.1",
        "socket.io": "^4.7.2",
        "xhr2": "^0.2.1"
    },
    "devDependencies": {
        "@microsoft/teams.dev": "^2.0.5",
        "@types/express": "^5.0.6",
        "@types/node": "^20.0.0",
        "env-cmd": "^10.1.0",
        "nodemon": "^3.1.7",
        "ts-node": "^10.4.0",
        "typescript": "^5.5.4"
    }
}
